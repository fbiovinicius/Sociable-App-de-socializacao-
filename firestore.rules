rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function ownRsvpPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid);
    }

    function attendeePath(eventId, ownerId) {
      return /databases/$(database)/documents/events/$(eventId)/attendees/$(ownerId);
    }

    function eventExists(eventId) {
      return exists(eventPath(eventId));
    }

    function eventData(eventId) {
      return get(eventPath(eventId)).data;
    }

    function eventGoingCount(eventId) {
      return eventData(eventId).get('goingCount', 0);
    }

    function eventCapacity(eventId) {
      return eventData(eventId).get('capacity', null);
    }

    function isEventOrganizer(eventId) {
      return signedIn() && eventExists(eventId)
        && eventData(eventId).organizerId == request.auth.uid;
    }

    function isEventOrganizerAfterWrite(eventId) {
      return signedIn()
        && getAfter(eventPath(eventId)).data.organizerId == request.auth.uid;
    }

    function hasRsvp(eventId) {
      return signedIn() && exists(ownRsvpPath(eventId));
    }

    function isEventParticipant(eventId) {
      return isEventOrganizer(eventId) || hasRsvp(eventId);
    }

    function onlyGoingCountChanged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['goingCount']);
    }

    function validAttendeeFields(data, ownerId) {
      return data.keys().hasOnly(['userId', 'name', 'photoUrl', 'createdAt'])
        && data.keys().hasAll(['userId', 'name', 'photoUrl', 'createdAt'])
        && data.name is string
        && data.name.size() <= 120
        && (
          data.photoUrl == null
          || (
            data.photoUrl is string
            && data.photoUrl.size() <= 500
            && data.photoUrl.matches('(?i)https://.+')
          )
        )
        && data.name == get(userPath(ownerId)).data.name
        && data.photoUrl == get(userPath(ownerId)).data.get('photoUrl', null);
    }

    function validProfileFields(data) {
      let name = data.get('name', '');
      let photoUrl = data.get('photoUrl', null);
      return name is string
        && name.size() >= 2
        && name.size() <= 60
        && (
          photoUrl == null
          || (
            photoUrl is string
            && photoUrl.size() <= 500
            && photoUrl.matches('(?i)https://.+')
          )
        );
    }

    function goingCountMatchesOwnRsvp(eventId) {
      let delta = request.resource.data.goingCount - resource.data.goingCount;
      return (delta == 1 && existsAfter(ownRsvpPath(eventId)))
        || (delta == -1 && !existsAfter(ownRsvpPath(eventId)));
    }

    match /users/{userId} {
      // Perfis são visíveis para usuários autenticados (nome, foto, bio).
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && validProfileFields(request.resource.data);
      // E-mail e data de criação são imutáveis pelo cliente. Nome e foto também
      // são validados para impedir URLs perigosas na prévia de participantes.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && validProfileFields(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.goingCount == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120;

      // O organizador edita o evento; qualquer pessoa só altera o contador
      // junto com o próprio RSVP (o contador é desnormalizado).
      allow update: if signedIn() && (
        (
          resource.data.organizerId == request.auth.uid
          && request.resource.data.organizerId == resource.data.organizerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.goingCount == resource.data.goingCount
          && request.resource.data.get('isSecret', false) == resource.data.get('isSecret', false)
          && request.resource.data.status in ['ACTIVE', 'CANCELLED']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
        )
        ||
        (
          onlyGoingCountChanged()
          && goingCountMatchesOwnRsvp(eventId)
          && (
            eventCapacity(eventId) == null
            || request.resource.data.goingCount <= eventCapacity(eventId)
          )
        )
      );

      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;

      match /rsvps/{userId} {
        allow read: if signedIn()
          && (request.auth.uid == userId || isEventOrganizer(eventId));

        // Criar RSVP exige que a mesma transação tenha incrementado goingCount.
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == userId
          && request.resource.data.checkedIn == false
          && (
            eventCapacity(eventId) == null
            || eventGoingCount(eventId) < eventCapacity(eventId)
          )
          && getAfter(eventPath(eventId)).data.get('goingCount', 0)
            == eventGoingCount(eventId) + 1
          && existsAfter(attendeePath(eventId, userId));

        // Check-in é feito pelo organizador.
        allow update: if signedIn()
          && isEventOrganizer(eventId)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['checkedIn', 'checkedInAt']);

        allow delete: if signedIn()
          && request.auth.uid == userId
          && getAfter(eventPath(eventId)).data.get('goingCount', 0)
            == eventGoingCount(eventId) - 1
          && !existsAfter(attendeePath(eventId, userId));
      }

      // Local real de um segredinho: só organizador e quem confirmou presença.
      match /private/{documentId} {
        allow read: if isEventParticipant(eventId);
        allow write: if isEventOrganizer(eventId) || isEventOrganizerAfterWrite(eventId);
      }

      // Prévia de participantes: documentos públicos com nome e foto de quem
      // confirmou presença. O documento é criado/apagado na mesma transação do
      // RSVP (o token de check-in fica no rsvp, que é privado). A consulta da
      // collection group filtrada pelo próprio userId tem uma regra recursiva
      // no final deste arquivo.
      match /attendees/{userId} {
        // A lista é pública nos eventos comuns. Em segredinhos, apenas o
        // organizador e quem confirmou presença podem consultar participantes.
        // A pessoa também pode consultar o próprio documento: a transação do
        // primeiro RSVP precisa verificar se ele já existe antes de escrevê-lo.
        allow get: if signedIn()
          && (
            request.auth.uid == userId
            || eventData(eventId).get('isSecret', false) == false
            || isEventParticipant(eventId)
          );

        allow list: if signedIn()
          && (
            eventData(eventId).get('isSecret', false) == false
            || isEventParticipant(eventId)
          )
          && request.query.limit <= 30;

        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == userId
          && validAttendeeFields(request.resource.data, userId)
          && request.resource.data.createdAt == request.time
          && existsAfter(ownRsvpPath(eventId));

        allow update: if signedIn()
          && request.auth.uid == userId
          && resource.data.userId == userId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['name', 'photoUrl'])
          && validAttendeeFields(request.resource.data, userId)
          && existsAfter(ownRsvpPath(eventId));

        allow delete: if signedIn()
          && request.auth.uid == userId
          && !existsAfter(ownRsvpPath(eventId));
      }

      // Denúncias do evento: uma por pessoa. O cliente só cria e consulta o
      // próprio registro; listagem e alterações ficam com a moderação.
      match /reports/{reporterId} {
        allow get: if signedIn() && request.auth.uid == reporterId;

        allow create: if signedIn()
          && request.auth.uid == reporterId
          && request.resource.data.keys().hasOnly([
            'eventId',
            'reporterId',
            'reason',
            'comment',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'eventId',
            'reporterId',
            'reason',
            'comment',
            'createdAt'
          ])
          && request.resource.data.reporterId == reporterId
          && request.resource.data.eventId is string
          && request.resource.data.eventId == eventId
          && eventId.size() > 0
          && eventId.size() <= 120
          && eventExists(eventId)
          && request.resource.data.reason is string
          && request.resource.data.reason in [
            'INAPPROPRIATE_CONTENT',
            'SPAM_OR_SCAM',
            'FAKE_EVENT',
            'WRONG_LOCATION',
            'OTHER'
          ]
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500
          && request.resource.data.createdAt == request.time;

        allow list, update, delete: if false;
      }

      // Chat: só organizador e quem confirmou presença leem e enviam.
      // Mensagens não podem ser editadas nem apagadas pelo cliente.
      match /messages/{messageId} {
        allow read: if isEventParticipant(eventId);

        allow create: if isEventParticipant(eventId)
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'sentAt'])
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'text', 'sentAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.sentAt == request.time;

        allow update, delete: if false;
      }

      // Avaliações: o id do documento é o uid do autor (uma por pessoa) e
      // só quem confirmou presença, e não organiza o evento, pode avaliar.
      match /reviews/{userId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == userId
          && hasRsvp(eventId)
          && eventData(eventId).organizerId != request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'rating', 'comment', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'rating', 'comment', 'createdAt'])
          && request.resource.data.authorId == userId
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 100
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 300
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // A sincronização do perfil consulta a collection group `attendees`.
    // O wildcard recursivo é necessário para essa consulta e continua
    // limitado ao próprio `userId`; nenhuma escrita passa por esta regra.
    match /{path=**}/attendees/{userId} {
      allow list: if signedIn()
        && request.query.limit <= 30
        && resource.data.userId == request.auth.uid;
    }
  }
}
